with "config/aegir_config.gpr";
project Aegir is

   type Arch_Type is ("riscv64");
   type Board_Type is ("qemu_virt_riscv64");

   Arch  : Arch_Type := external ("AKERNEL_ARCH", "riscv64");
   Board : Board_Type := external ("AKERNEL_BOARD", "qemu_virt_riscv64");

   for Source_Dirs use
     ("src/kernel",
      "src/arch/" & Arch,
      "src/board/" & Board,
      "config");
   for Object_Dir use "obj/" & Aegir_Config.Build_Profile & "/" & Arch & "/" & Board;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("aegir.adb");
   for Languages use ("Ada", "Asm");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "light-rv64imafdc";

   package Builder is
      for Executable ("aegir.adb") use "aegir.elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Aegir_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use
        ("-T", Project'Project_Dir & "src/board/" & Board & "/linker.ld");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Aegir;
