project Serial extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/serial";
   for Main use ("serial.adb");

   package Builder is
      for Executable ("serial.adb") use "serial.elf";
   end Builder;
end Serial;
