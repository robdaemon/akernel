project Ping extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/ping";
   for Main use ("ping.adb");

   package Builder is
      for Executable ("ping.adb") use "ping.elf";
   end Builder;
end Ping;
