project Procfs is
   for Source_Dirs use (".", "../rts/akernel");
   for Object_Dir use "../../obj/userspace/procfs";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../../bin/userspace";
   for Languages use ("Ada", "Asm");
   for Main use ("procfs.adb");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "light-rv64imafdc";

   package Builder is
      for Executable ("procfs.adb") use "procfs.elf";
   end Builder;

   --  Vendored light-runtime additions (see serial.gpr).
   package Compiler is
      for Switches ("a-stream.ads") use ("-gnatg");
      for Switches ("a-stream.adb") use ("-gnatg");
      for Switches ("a-ioexce.ads") use ("-gnatg");
      for Switches ("s-memory.adb") use ("-gnatg");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-T", Project'Project_Dir & "../rts/akernel/linker-riscv64.ld");
   end Linker;
end Procfs;
