with "../trinket/trinket.gpr";

project Demo extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/demo";
   for Main use ("demo.adb");

   package Builder is
      for Executable ("demo.adb") use "demo.elf";
   end Builder;
end Demo;
