project Memstage extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/memstage";
   for Main use ("memstage.adb");

   package Builder is
      for Executable ("memstage.adb") use "memstage.elf";
   end Builder;
end Memstage;
