project Spin extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/spin";
   for Main use ("spin.adb");

   package Builder is
      for Executable ("spin.adb") use "spin.elf";
   end Builder;
end Spin;
