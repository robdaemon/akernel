project Cxx_Test extends "../rts/akernel_program.gpr" is
   --  Milestone 82a: first mixed Ada/C++ crate. The C++ units are
   --  compiled by the vendored xPack riscv-none-elf-g++ (the Alire
   --  Ada toolchain ships no C++ compiler): the root Makefile's
   --  stamp rule drops a riscv64-elf-g++ wrapper into
   --  third_party/toolchains/cxxbin/ and prepends it to PATH, so
   --  gprbuild's autoconfiguration finds a C++ toolchain for the
   --  riscv64-elf target by name (a Driver override is not enough —
   --  without a knowledge-base toolchain match gprbuild misdrives
   --  the compiler).
   for Languages use ("Ada", "C++");
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/cxx_test";
   for Main use ("cxx_test.adb");

   package Builder is
      for Executable ("cxx_test.adb") use "cxx_test.elf";
   end Builder;

   package Compiler is
      --  Freestanding C++ for the Haiku BFS vendoring (M82): no
      --  exceptions, no RTTI, no libstdc++ headers (Haiku kernel
      --  code uses its own templates); operator new/delete and
      --  __cxa_pure_virtual live in the TU itself here and will
      --  move to the bfs port/ layer in M82c. -march/-mabi arrive
      --  via the runtime's required switches and match the Ada
      --  toolchain exactly (rv64imafdc/lp64d).
      for Switches ("C++") use
        ("-O2",
         "-ffreestanding",
         "-fno-exceptions",
         "-fno-rtti",
         "-fno-use-cxa-atexit",
         "-fno-threadsafe-statics",
         "-nostdinc++",
         "-Wall",
         "-Werror");
   end Compiler;
end Cxx_Test;
