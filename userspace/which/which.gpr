project Which extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/which";
   for Main use ("which.adb");

   package Builder is
      for Executable ("which.adb") use "which.elf";
   end Builder;
end Which;
