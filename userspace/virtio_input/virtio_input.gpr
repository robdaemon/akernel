with "../virtio/virtio.gpr";
project Virtio_Input extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/userspace/virtio_input";
   for Main use ("virtio_input.adb");

   package Builder is
      for Executable ("virtio_input.adb") use "virtio_input.elf";
   end Builder;
end Virtio_Input;
