with "../lwip/lwip.gpr";

--  m72a: links liblwip.a (fetched + built from third_party/lwip by
--  the top-level Makefile LWIP_* rules); the hand-rolled stack still
--  serves packets at this stage, lwIP only initialises.
project Netserv extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/netserv";
   for Main use ("netserv.adb");

   package Builder is
      for Executable ("netserv.adb") use "netserv.elf";
   end Builder;
end Netserv;
