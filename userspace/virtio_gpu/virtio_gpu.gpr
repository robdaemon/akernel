with "../virtio/virtio.gpr";

project Virtio_Gpu is
   for Source_Dirs use (".", "../rts/akernel");
   for Object_Dir use "../../obj/userspace/virtio_gpu";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../../bin/userspace";
   for Languages use ("Ada", "Asm");
   for Main use ("virtio_gpu.adb");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "light-rv64imafdc";

   package Builder is
      for Executable ("virtio_gpu.adb") use "virtio_gpu.elf";
   end Builder;

   --  Vendored light-runtime additions (Ada.Streams + friends live
   --  in ../rts/akernel): GNAT only accepts descendants of package
   --  Ada in implementation mode.
   package Compiler is
      for Switches ("a-stream.ads") use ("-gnatg");
      for Switches ("a-stream.adb") use ("-gnatg");
      for Switches ("a-ioexce.ads") use ("-gnatg");
      for Switches ("s-memory.adb") use ("-gnatg");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-T", Project'Project_Dir & "../rts/akernel/linker-riscv64.ld");
   end Linker;
end Virtio_Gpu;
