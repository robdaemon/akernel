with "../virtio/virtio.gpr";
project Virtio_Gpu extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/userspace/virtio_gpu";
   for Main use ("virtio_gpu.adb");

   package Builder is
      for Executable ("virtio_gpu.adb") use "virtio_gpu.elf";
   end Builder;
end Virtio_Gpu;
