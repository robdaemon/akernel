project Fat32 extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/fat32";
   for Main use ("fat32.adb");

   package Builder is
      for Executable ("fat32.adb") use "fat32.elf";
   end Builder;
end Fat32;
