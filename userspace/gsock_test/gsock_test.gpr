project Gsock_Test extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/gsock_test";
   for Main use ("gsock_test.adb");

   package Builder is
      for Executable ("gsock_test.adb") use "gsock_test.elf";
   end Builder;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Gsock_Test;
