project Type_Util extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/type";
   for Main use ("type_cmd.adb");

   package Builder is
      for Executable ("type_cmd.adb") use "type.elf";
   end Builder;
end Type_Util;
