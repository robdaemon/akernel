with "../trinket/trinket.gpr";

project Terminal extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/terminal";
   for Main use ("terminal.adb");

   package Builder is
      for Executable ("terminal.adb") use "terminal.elf";
   end Builder;
end Terminal;
