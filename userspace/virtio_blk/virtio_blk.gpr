with "../virtio/virtio.gpr";
project Virtio_Blk extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/virtio_blk";
   for Main use ("virtio_blk.adb");

   package Builder is
      for Executable ("virtio_blk.adb") use "virtio_blk.elf";
   end Builder;
end Virtio_Blk;
