with "../trinket/trinket.gpr";

project Tdemo extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/tdemo";
   for Main use ("tdemo.adb");

   package Builder is
      for Executable ("tdemo.adb") use "tdemo.elf";
   end Builder;
end Tdemo;
