project Teardown extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/teardown";
   for Main use ("teardown.adb");

   package Builder is
      for Executable ("teardown.adb") use "teardown.elf";
   end Builder;
end Teardown;
