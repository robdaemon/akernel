project Libman extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/libman";
   for Main use ("libman.adb");

   package Builder is
      for Executable ("libman.adb") use "libman.elf";
   end Builder;
end Libman;
