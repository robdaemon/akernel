project Copy extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/copy";
   for Main use ("copy.adb");

   package Builder is
      for Executable ("copy.adb") use "copy.elf";
   end Builder;
end Copy;
