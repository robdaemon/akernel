with "../trinket/trinket.gpr";
with "../scripting/scripting.gpr";

project Drawer extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/drawer";
   for Main use ("drawer.adb");

   package Builder is
      for Executable ("drawer.adb") use "drawer.elf";
   end Builder;
end Drawer;
