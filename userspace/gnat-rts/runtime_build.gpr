--  Builds the akernel userspace GNAT runtime (milestone 53a):
--  a near-native libgnat for riscv64-elf — full ZCX exception
--  propagation (raise-gcc.c + __gnat_personality_v0 + static
--  .eh_frame_hdr lookup via unwind-dw2-fde-bb.c), finalization,
--  secondary stack, containers, numerics. Tasking is excluded by
--  gnat_user/system.ads (No_Tasking) until the kernel grows
--  userspace thread-spawn + TLS (the s-taprop milestone).
--
--  Sources: gnat/ is the embedded-polarfiresoc pool of the
--  gnat_riscv64_elf 15.3.1 Alire toolchain (the full gcc-15.3.1
--  libgnat common set) minus board files (i-fe310*, newlib-bb.c,
--  start-ram.S) and minus the units gnat_user/ shadows
--  (system.ads, s-memory.adb — the akernel memobj heap).
--
--  Layout mirrors a shipped bb runtime: gnat_user/ first in
--  ada_source_path (override dir), adalib/ holds libgnat.a + ALIs,
--  runtime.xml carries the target switches. Programs reference the
--  runtime by path (for Runtime ("Ada") use "../gnat-rts").

project Runtime_Build is
   for Languages use ("Ada", "C");
   for Runtime ("Ada") use Project'Project_Dir;
   for Target use "riscv64-elf";

   for Library_Auto_Init use "False";
   for Library_Name use "gnat";
   for Library_Kind use "static";

   for Library_Dir use "adalib";
   for Object_Dir use "obj";
   for Source_Dirs use ("gnat_user", "gnat");
   for Create_Missing_Dirs use "True";

   COMFLAGS := ("-ffunction-sections", "-fdata-sections", "-O2");
   ADAFLAGS := ("-gnatg", "-nostdinc", "-fno-delete-null-pointer-checks",
                "-gnatp", "-gnatn2") & COMFLAGS;
   CFLAGS   := ("-DIN_RTS", "-Dinhibit_libc", "-Werror", "-Wall")
               & COMFLAGS;

   package Compiler is
      for Default_Switches ("C") use CFLAGS;
      for Default_Switches ("Ada") use ADAFLAGS;

      --  Per-file knobs from the shipped target_options.gpr: the
      --  exception machinery must not be inlined or reordered.
      for Switches ("a-except.adb") use ADAFLAGS
        & ("-O1", "-fno-inline", "-fno-toplevel-reorder");
      for Switches ("s-excdeb.adb") use ADAFLAGS & ("-O0");
      for Switches ("raise-gcc.c") use CFLAGS & ("-fexceptions");
   end Compiler;
end Runtime_Build;
