--  Builds the Akernel userspace GNAT runtime (milestones 53a + 67b):
--  a near-native libgnat for riscv64-elf with full ZCX exception
--  propagation (raise-gcc.c + __gnat_personality_v0 + crt0
--  __register_frame of .eh_frame, milestone 53a), finalization,
--  secondary stack, containers, numerics and Ravenscar tasking.
--
--  Sources: gnat/ is the embedded-polarfiresoc pool of the
--  gnat_riscv64_elf 15.3.1 Alire toolchain (the full gcc-15.3.1
--  libgnat common set) minus board files (i-fe310*, newlib-bb.c,
--  start-ram.S) and minus units gnat_user/ shadows
--  (s-memory.adb -- the akernel memobj heap). gnat_full/ (milestone
--  53b) vendors the FULL file-I/O stack from the gcc-15.3.0 tarball.
--  gnarl_user/ supplies the tasking/Ravenscar overrides (system.ads,
--  s-osinte.adb, s-taprop.adb, s-multip.adb, System.Soft_Links).
--
--  Layout mirrors a shipped bb runtime: gnat_user/ + gnarl_user/ first
--  in ada_source_path (override dirs), adalib/ holds libgnat.a + ALIs,
--  runtime.xml carries the target switches. Programs reference the
--  runtime by path (for Runtime ("Ada") use "../gnat-rts").

project Runtime_Build is
   for Languages use ("Ada", "C");
   for Runtime ("Ada") use Project'Project_Dir;
   for Target use "riscv64-elf";

   for Library_Auto_Init use "False";
   for Library_Name use "gnat";
   for Library_Kind use "static";

   for Library_Dir use "adalib";
   for Object_Dir use "obj";
   for Source_Dirs use ("gnarl_user", "gnat_user", "gnat_full", "gnat");
   for Excluded_Source_Files use ("s-sssita.ads", "s-sssita.adb");
   for Create_Missing_Dirs use "True";

   COMFLAGS := ("-ffunction-sections", "-fdata-sections", "-O2");
   ADAFLAGS := ("-gnatg", "-nostdinc", "-fno-delete-null-pointer-checks",
                "-gnatp", "-gnatn2") & COMFLAGS;
   CFLAGS   := ("-DIN_RTS", "-DSTANDALONE", "-Dinhibit_libc", "-DAKERNEL_NO_DIRENT", "-DAKERNEL_ENV_FILES", "-DAKERNEL_NO_UTIME",
                "-Werror", "-Wall", "-Wno-deprecated-declarations", "-Wno-unused-variable")
               & COMFLAGS;

   package Compiler is
      for Default_Switches ("C") use CFLAGS;
      for Default_Switches ("Ada") use ADAFLAGS;

      --  Per-file knobs from the shipped target_options.gpr: the
      --  exception machinery must not be inlined or reordered.
      for Switches ("a-except.adb") use ADAFLAGS
        & ("-O1", "-fno-inline", "-fno-toplevel-reorder");
      for Switches ("s-excdeb.adb") use ADAFLAGS & ("-O0");
      for Switches ("raise-gcc.c") use CFLAGS & ("-fexceptions");
      --  Vendored gcc/ada C support: warnings are not ours to fix.
      for Switches ("adaint.c") use CFLAGS & ("-Wno-error");
      for Switches ("cstreams.c") use CFLAGS & ("-Wno-error");
      for Switches ("sysdep.c") use CFLAGS & ("-Wno-error");
      for Switches ("targext.c") use CFLAGS & ("-Wno-error");
      for Switches ("errno.c") use CFLAGS & ("-Wno-error");
      for Switches ("env.c") use CFLAGS & ("-Wno-error");
      for Switches ("argv.c") use CFLAGS & ("-Wno-error");
      for Switches ("cal.c") use CFLAGS & ("-Wno-error");
   end Compiler;
end Runtime_Build;
