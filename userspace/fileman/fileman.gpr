with "../trinket/trinket.gpr";

project Fileman extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/fileman";
   for Main use ("fileman.adb");

   package Builder is
      for Executable ("fileman.adb") use "fileman.elf";
   end Builder;
end Fileman;
