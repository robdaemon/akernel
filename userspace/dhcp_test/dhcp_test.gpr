project Dhcp_Test extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/dhcp_test";
   for Main use ("dhcp_test.adb");

   package Builder is
      for Executable ("dhcp_test.adb") use "dhcp_test.elf";
   end Builder;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Dhcp_Test;
