project Makedir extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/makedir";
   for Main use ("makedir.adb");

   package Builder is
      for Executable ("makedir.adb") use "makedir.elf";
   end Builder;
end Makedir;
