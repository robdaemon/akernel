project Partmgr extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/partmgr";
   for Main use ("partmgr.adb");

   package Builder is
      for Executable ("partmgr.adb") use "partmgr.elf";
   end Builder;
end Partmgr;
