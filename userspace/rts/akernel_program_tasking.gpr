--  Base project for userspace programs that use Ada tasking.
--  Extends akernel_rts_tasking.gpr (built against the Ravenscar runtime).

with "akernel_rts_tasking.gpr";

abstract project Akernel_Program_Tasking is
   for Languages use ("Ada", "Asm");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "../gnat-rts-tasking";
   for Exec_Dir use "../../bin/userspace";
   for Create_Missing_Dirs use "True";

   package Linker is
      for Switches ("Ada") use
        ("-T", Akernel_RTS_Tasking'Project_Dir & "/akernel/linker-riscv64.ld",
         "-Wl,-u,_sbrk");
   end Linker;
end Akernel_Program_Tasking;
