--  Base project for every userspace program (milestone 40): crates
--  `extend` this and inherit the RTS dependency, toolchain,
--  runtime, exec dir and linker script. A program project is:
--
--    project Foo extends "../rts/akernel_program.gpr" is
--       for Source_Dirs use (".");
--       for Object_Dir use "../../obj/userspace/foo";
--       for Main use ("foo.adb");
--       package Builder is
--          for Executable ("foo.adb") use "foo.elf";
--       end Builder;
--    end Foo;
with "akernel_rts.gpr";

abstract project Akernel_Program is
   for Languages use ("Ada");
   for Target use "riscv64-elf";
   for Runtime ("Ada") use "../gnat-rts";
   for Exec_Dir use "../../bin/userspace";
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  M84 paint-perf finding: the runtime's required switches
      --  (runtime.xml: -gnatA -fno-tree-loop-distribute-patterns)
      --  carry NO -O flag, so every userspace program built at
      --  -O0 — the compositor's per-pixel loops measured ~0.5
      --  us/pixel (a full-window composite ~0.5 s). Project
      --  switches land after the runtime's, so this wins.
      for Switches ("Ada") use ("-O2");
   end Compiler;

   package Linker is
      --  Milestone 53b: newlib comes in via GROUP(-lc -lm) in
      --  the linker script (gprbuild drops Linker'Linker_Options
      --  silently and plain Switches land before the runtime libs
      --  on the single-pass link line — the 53b link burn). The
      --  -u forces ld to treat _sbrk as undefined from the start
      --  so Akernel_User.Gloss (the syscall layer libc calls) is
      --  pulled from libakernel_user.a even though no program
      --  source names it; pulling it through the script GROUP
      --  stranded its libgnat references.
      for Switches ("Ada") use
        ("-T", Akernel_RTS'Project_Dir & "/akernel/linker-riscv64.ld",
         "-Wl,-u,_sbrk",
         "-Wl,-z,noexecstack");
   end Linker;
end Akernel_Program;
