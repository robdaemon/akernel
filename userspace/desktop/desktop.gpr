with "../trinket/trinket.gpr";

project Desktop extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/desktop";
   for Main use ("desktop.adb");

   package Builder is
      for Executable ("desktop.adb") use "desktop.elf";
   end Builder;
end Desktop;
