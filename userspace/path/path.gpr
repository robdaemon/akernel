project Path extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/path";
   for Main use ("path.adb");

   package Builder is
      for Executable ("path.adb") use "path.elf";
   end Builder;
end Path;
