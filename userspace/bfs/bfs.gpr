project Bfs extends "../rts/akernel_program.gpr" is
   --  Milestone 82c: pure-Ada read-only BeFS server (bfs_engine),
   --  re-implemented from the on-disk format with the MIT-licensed
   --  Haiku BFS sources as reference reading.
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/bfs";
   for Main use ("bfs.adb");

   package Builder is
      for Executable ("bfs.adb") use "bfs.elf";
   end Builder;
end Bfs;
