project Fuzz extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/fuzz";
   for Main use ("fuzz.adb");

   package Builder is
      for Executable ("fuzz.adb") use "fuzz.elf";
   end Builder;
end Fuzz;
