with "../scripting/scripting.gpr";

project Shell extends "../rts/akernel_program.gpr" is
   for Source_Dirs use (".");
   for Exec_Dir use "../../bin/userspace";
   for Object_Dir use "../../obj/userspace/shell";
   for Main use ("shell.adb");

   package Builder is
      for Executable ("shell.adb") use "shell.elf";
   end Builder;
end Shell;
